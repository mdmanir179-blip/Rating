rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Default deny all unknown paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Users Collection (Allow read & write for customer profiles and admin management)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Products Collection (Available for marketplace view, real-time sync & admin edits)
    match /products/{productId} {
      allow read, write: if true;
    }

    // Offer Banners (Shown in customer portal between product feeds)
    match /banners/{bannerId} {
      allow read, write: if true;
    }

    // Review Submissions (Customers submit ratings & admin approves)
    match /reviews/{reviewId} {
      allow read, write: if true;
    }

    // Subscription Payments (Customers choose plan, admin approves)
    match /subscriptions/{subId} {
      allow read, write: if true;
    }

    // Withdrawals (Customers request payouts in INR to UPI/Bank)
    match /withdrawals/{withdrawalId} {
      allow read, write: if true;
    }

    // System Settings (Admin payment details, QR Scanner, UPI, Bank)
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
